# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
ASSISTANT_MODEL=claude-haiku-5-5
LLM_BACKEND=anthropic          # anthropic | ollama
LLM_FALLBACK=none              # none | ollama  (switch to local Llama if the API fails)
OLLAMA_MODEL=llama3.1:8b

EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_WORDS=180
CHUNK_OVERLAP=30
TOP_K=5
SIM_CUTOFF=0.30                # tune with eval/run_eval.py

SANDBOX_BACKEND=docker         # never "local" outside tests
SANDBOX_IMAGE=prv201-sandbox:latest
SANDBOX_TIMEOUT_S=10
SANDBOX_MEMORY_MB=512
MAX_TOOL_CALLS=2
